{
  "expo": {
    "name": "StayFlow Mobile",
    "slug": "stayflow-mobile",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "primaryColor": "#6C63FF",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0E1A"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0E1A"
      },
      "package": "com.stayflow.mobile",
      "versionCode": 2
    },
    "notification": {
      "icon": "./assets/notification-icon.png",
      "color": "#6C63FF"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "0c828233-29dd-49ab-9db4-565fbca03b3e"
      },
      "apiUrl": "https://stayflow-tkto.onrender.com/api/"
    },
    "owner": "goeswar98"
  }
}
