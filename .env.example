# WhatsApp Cloud API Configuration (Optional - whatsapp-web.js is free alternative)
WHATSAPP_TOKEN=your_permanent_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_VERIFY_TOKEN=any_random_string_here_for_webhook_setup
WHATSAPP_CALLBACK_URL=https://your-server.ngrok-free.app/webhook

# Google Sheets Configuration (Required)
GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_SERVICE_ACCOUNT_EMAIL=your_service_account_email@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour\nKey\nHere\n-----END PRIVATE KEY-----\n"

# Business Details (Required)
BUSINESS_NAME=StayFlow PG
OWNER_PHONE=919876543210
OWNER_UPI_ID=ownername@upi

# Billing Configuration
MONTHLY_RENT_DUE_DATE=5
EB_DUE_DATE=10
EB_UNIT_RATE=15

# Registration Form URL (Optional - defaults to local)
GOOGLE_FORM_URL=https://forms.gle/YOUR_FORM_ID

# Optional Integrations
GROQ_API_KEY=your_groq_api_key_for_ai
RAZORPAY_KEY_ID=your_razorpay_key
RAZORPAY_KEY_SECRET=your_razorpay_secret

# MongoDB (Optional - for logging)
MONGODB_URI=mongodb://localhost:27017/stayflow

# Server Port
PORT=3000

# Security
ADMIN_API_KEY=stayflow_dev_key_123
VITE_ADMIN_API_KEY=stayflow_dev_key_123
