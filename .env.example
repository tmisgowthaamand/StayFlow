# ═══════════════════════════════════════
# StayFlow Environment Variables
# ═══════════════════════════════════════
# NEVER commit real values. Copy this to .env and fill in.

# ── Business Config ──
BUSINESS_NAME=StayFlow
OWNER_PHONE=91XXXXXXXXXX
OWNER_UPI_ID=your-upi@bank
MONTHLY_RENT_DUE_DATE=5
EB_DUE_DATE=10
EB_UNIT_RATE=15

# ── WhatsApp Cloud API ──
WHATSAPP_TOKEN=your_whatsapp_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=your_verify_token
WHATSAPP_CALLBACK_URL=https://your-domain.com/webhook
WHATSAPP_APP_SECRET=your_app_secret_for_webhook_verification

# ── Google Sheets ──
GOOGLE_SHEET_ID=your_sheet_id
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-sa@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----"

# ── MongoDB ──
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/stayflow

# ── Authentication ──
ADMIN_API_KEY=generate_a_random_32_char_key_here

# ── Razorpay ──
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ── AI Services ──
GEMINI_API_KEY=your_gemini_key
GROQ_API_KEY=your_groq_key

# ── Google Maps ──
GOOGLE_MAPS_API_KEY=your_maps_key

# ── Deployment ──
RENDER_API_URL=https://your-app.onrender.com
ALLOWED_ORIGINS=https://your-dashboard.vercel.app,https://your-app.onrender.com
PORT=3000
